        "task_prefix": "[CFG_STYLE_WARM_LOCAL_TASK] ",
        "action_prefix": "[CFG_STYLE_WARM_LOCAL_ACTION] ",
        "external_clarify_prefix": "[CFG_STYLE_WARM_LOCAL_EXTERNAL_CLARIFY] ",
